{
  "name": "astha",
  "private": true,
  "version": "1.0.0",
  "description": "Astha -- a Bangla-first, voice-led AI visual companion for blind and low-vision users.",
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node tools/check.mjs",
    "build": "python tools/build.py",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "install:server": "npm --prefix server ci",
    "cap:sync": "python tools/build.py && npx cap sync",
    "capacitor:copy:after": "node tools/prune-mobile-assets.mjs",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
