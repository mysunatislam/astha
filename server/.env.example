PORT=8787
JWT_SECRET=replace-with-a-long-random-string
DB_PATH=./data/astha.db
# Supabase is the selected production database. SQLite remains an explicit dev option.
DB_PROVIDER=supabase
# Secret Postgres connection string from the selected project's Connect dialog,
# using the restricted astha_backend login (pooler: astha_backend.PROJECT_REF).
# Keep this on the server; a project HTTPS URL or publishable key is insufficient.
SUPABASE_DB_URL=
# Optional trusted project root certificate file; TLS validation always stays enabled.
SUPABASE_DB_CA_FILE=
NODE_ENV=production
# Maira is the selected production AI provider. Keep deployment credentials only on the server.
CLOUD_AI_PROVIDER=maira
MAIRA_API_KEY=
MAIRA_PROJECT_KEY=
# Optional: use a reviewed ASTHA profile in your project, or leave empty for the project default.
MAIRA_PROFILE_ID=
MAIRA_API_URL=https://api.recommender.gigalogy.com/v1/maira/ask
# Existing Gemini support remains available when CLOUD_AI_PROVIDER=gemini (or auto).
GEMINI_API_KEY=
# Stable default; up to 3 exact IDs in evaluation-approved fallback order (404 only).
GEMINI_MODELS=gemini-3.6-flash
# Exact public API/web origin, e.g. https://astha.onrender.com. Set behind TLS termination.
# This preserves same-origin requests without trusting arbitrary forwarded headers.
PUBLIC_ORIGIN=
# Exact additional frontend origins, comma-separated; include native origins only when used.
# Examples: https://your-frontend.example,https://localhost,capacitor://localhost
CORS_ORIGIN=
# Keep 0 for direct access. Set 1..3 only after verifying every ingress path has that many
# trusted proxies that overwrite X-Forwarded-Proto and append the actual client IP.
# Otherwise forwarded headers can be spoofed. With 0, proxy clients share the proxy's rate limit.
TRUST_PROXY_HOPS=0
